{
  "name": "@arion/analyst",
  "version": "0.3.0",
  "description": "The Arion simulation result viewer Angular application",
  "repository": "github:aethonholdings/aethon-arion-analyst",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write src/**/*.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test:smoke": "node e2e/smoke.js",
    "test:smoke:record": "node e2e/record.js",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-browser-dynamic": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@types/cytoscape": "^3.21.9",
    "aethon-api-types": "^0.0.4",
    "aethon-arion-c1": "^0.5.0",
    "aethon-arion-pipeline": "^0.6.0",
    "aethon-paginate-types": "^0.0.4",
    "chart.js": "^4.5.1",
    "cytoscape": "^3.31.1",
    "cytoscape-cose-bilkent": "^4.1.0",
    "flat": "^5.0.2",
    "ng2-charts": "^11.0.0",
    "ngx-spinner": "^22.0.1",
    "qs": "^6.14.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@types/jasmine": "~4.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "autoprefixer": "^10.4.24",
    "daisyui": "^4.12.24",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "openapi-to-md": "^1.0.25",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "@types/node": "~22.10.0",
    "prettier": "^3.10.1"
  }
}
